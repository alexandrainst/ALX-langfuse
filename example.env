# Langfuse stack config. Copy to `.env` and fill in real values.
#
#   cp example.env .env
#
# See README.md.
#

# --- Web UI -----------------------------------------------------------------
# Host port for the UI, and the URL the server advertises to browsers.
# Keep the port in LANGFUSE_BASE_URL in sync with LANGFUSE_WEB_PORT.
LANGFUSE_WEB_PORT=3000
LANGFUSE_BASE_URL=http://localhost:3000

# Timezone for the Postgres container.
LANGFUSE_TZ=Europe/Copenhagen

# --- Server secrets ---------------------------------------------------------
# ENCRYPTION_KEY:  openssl rand -hex 32
# NEXTAUTH_SECRET: openssl rand -base64 32
# SALT:            openssl rand -base64 32
ENCRYPTION_KEY='YOUR_ENCRYPTION_KEY_HERE'
NEXTAUTH_SECRET='YOUR_NEXTAUTH_SECRET_HERE'
SALT='YOUR_SALT_HERE'

# --- Datastore credentials --------------------------------------------------
# Use generated values for anything beyond local dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

REDIS_AUTH=langfuse-dev-redis

# --- First-boot bootstrap ---------------------------------------------------
# Applied ONLY when the Postgres volume is empty. On every later start these
# are inert: they do not re-seed or reconcile an existing instance.
#
# Without them a fresh instance has no account to log in with. 
LANGFUSE_INIT_ORG_ID='alexandra-institute'
LANGFUSE_INIT_ORG_NAME='Alexandra Institute'
LANGFUSE_INIT_USER_EMAIL='admin@langfuse.local'
LANGFUSE_INIT_USER_NAME='Admin'
LANGFUSE_INIT_USER_PASSWORD='YOUR_ADMIN_PASSWORD_HERE' # openssl rand -base64 24

LANGFUSE_INIT_PROJECT_ID='chat-broker-project'
LANGFUSE_INIT_PROJECT_NAME='Chat Broker'
LANGFUSE_INIT_PROJECT_PUBLIC_KEY='pk-lf-YOUR_PUBLIC_KEY' # pk-lf-$(openssl rand -hex 16)
LANGFUSE_INIT_PROJECT_SECRET_KEY='sk-lf-YOUR_SECRET_KEY' # sk-lf-$(openssl rand -hex 16)
